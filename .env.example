# Telegram Bot Token
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# OSM Nominatim API Endpoint (optional, defaults to public instance)
OSM_ENDPOINT=https://nominatim.openstreetmap.org

# Wikipedia search radius in meters (optional, defaults to 100)
SEARCH_RADIUS_M=100

# --- LLM Configuration ---
# OpenAI API Key
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# LLM Model name (e.g., gpt-4o, gpt-4o-mini)
LLM_MODEL=gpt-4o-mini
# OpenAI-compatible API endpoint (optional)
# OPENAI_BASE_URL=http://localhost:11434/v1

# Overpass API Endpoint (optional, defaults to public instance)
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
